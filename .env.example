# Proveedor de LLM a usar: openai | anthropic
LLM_PROVIDER=anthropic

# API key de OpenAI (necesaria si LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Modelo de OpenAI a usar (necesario si LLM_PROVIDER=openai)
OPENAI_MODEL=

# API key de Anthropic (necesaria si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Modelo de Anthropic a usar
ANTHROPIC_MODEL=claude-opus-5-5

# Tiempo máximo de espera por request, en segundos (lo usa el SDK como timeout)
LLM_TIMEOUT_SECONDS=30

# Cantidad de reintentos nativos del SDK ante errores transitorios
LLM_MAX_RETRIES=2
